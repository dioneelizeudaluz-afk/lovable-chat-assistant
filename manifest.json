{
  "manifest_version": 3,
  "name": "Lovable Chat Assistant",
  "version": "2.0.0",
  "description": "Cliente de chat para Lovable.dev com bloqueio de créditos",
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "*://*.lovable.dev/*",
    "*://api.lovable.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
